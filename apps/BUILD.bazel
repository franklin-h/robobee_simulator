# Fixed/welded Simulink server: same TCP protocol as robobee_simulink_server but
# built without ROBOBEE_FREE_FLIGHT, so the root body is welded to world (the
# same configuration as the default visualize_robobee_aeromechanical build).
# Simulink drives the wing voltages while the airframe is held fixed, and the
# net aerodynamic wrench about the COM is logged so tools/plot_com_wrench.py can
# be run against it while the TCP session is live.
cc_binary(
    name = "robobee_simulink_server_fixed",
    srcs = [
        "robobee_simulink_tcp.cc",
        "robobee_simulink_tcp.h",
        "visualize_robobee_aeromechanical.cc",
    ],
    copts = [
        "-DROBOBEE_SIMULINK_SERVER",
    ],
    data = [
        "//models/robobee_assembly:files",
    ],
    deps = [
        "//:aeromechanical_moments",
        "@drake//geometry:drake_visualizer",
        "@drake//geometry:shape_specification",
        "@drake//lcm:drake_lcm",
        "@drake//math:geometric_transform",
        "@drake//multibody/parsing:parsing",
        "@drake//multibody/plant:externally_applied_spatial_force",
        "@drake//multibody/plant:plant",
        "@drake//multibody/tree:tree",
        "@drake//systems/analysis:simulator",
        "@drake//systems/framework:diagram_builder",
        "@drake//systems/framework:leaf_system",
        "@drake//systems/framework:vector",
    ],
)

