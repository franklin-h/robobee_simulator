# The default aeromechanical build already welds the root body to world, so it is
# the "fixed" configuration used to characterize wing thrust/torque about the
# COM. This alias gives that configuration an explicit, discoverable name.
alias(
    name = "visualize_robobee_aeromechanical_fixed",
    actual = ":visualize_robobee_aeromechanical",
)

cc_binary(
    name = "visualize_robobee_aeromechanical_flying",
