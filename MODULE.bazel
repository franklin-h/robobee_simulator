module(name = "robobee_simulator")

bazel_dep(name = "apple_support", version = "2.5.4")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "drake")

DRAKE_COMMIT = "master"
DRAKE_CHECKSUM = None

archive_override(
    module_name = "drake",
    urls = [
        "https://github.com/RobotLocomotion/drake/archive/{}.tar.gz".format(DRAKE_COMMIT),
    ],
    sha256 = DRAKE_CHECKSUM,
    strip_prefix = "drake-{}".format(DRAKE_COMMIT.lstrip("v")),
)
